# ==============================================================================
# Python .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# Cython debug symbols
cython_debug/

# ------------------------------------------------------------------------------
# Distribution / packaging
# ------------------------------------------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
virtualenv/
.python-version

# Environment variable files (keep templates)
.env.*
!.env.example
!.env.template
!.env.sample

# ------------------------------------------------------------------------------
# Dependency / package managers
# ------------------------------------------------------------------------------
# pipenv (commit Pipfile.lock for applications, ignore for libraries)
# Pipfile.lock

# poetry (commit poetry.lock for applications, ignore for libraries)
# poetry.lock

# pdm
.pdm.toml
.pdm-python
.pdm-build/
__pypackages__/

# uv (commit uv.lock for applications)
# uv.lock

# pixi
.pixi/

# Conda
.conda/
conda-meta/

# pyenv / asdf / mise
.tool-versions
.mise.toml

# ------------------------------------------------------------------------------
# Testing / coverage
# ------------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
coverage/
*.cover
*.py,cover
.cache
nosetests.xml
.hypothesis/
.pytest_cache/
cover/
.pytest_cache/
.testmondata
.benchmarks/
pytestdebug.log

# ------------------------------------------------------------------------------
# Type checkers / linters / formatters
# ------------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.pyright/
.ruff_cache/
.flake8.cache
.pylint.d/
.pylintrc.local
.black_cache/
.isort.cfg.local

# ------------------------------------------------------------------------------
# Documentation
# ------------------------------------------------------------------------------
docs/_build/
docs/build/
site/
_build/
.doctrees/

# ------------------------------------------------------------------------------
# Jupyter / IPython
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# Django
# ------------------------------------------------------------------------------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# ------------------------------------------------------------------------------
# Flask
# ------------------------------------------------------------------------------
instance/
.webassets-cache

# ------------------------------------------------------------------------------
# Scrapy
# ------------------------------------------------------------------------------
.scrapy

# ------------------------------------------------------------------------------
# Celery
# ------------------------------------------------------------------------------
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# SageMath
# ------------------------------------------------------------------------------
*.sage.py

# ------------------------------------------------------------------------------
# Spyder / Rope
# ------------------------------------------------------------------------------
.spyderproject
.spyproject
.ropeproject

# ------------------------------------------------------------------------------
# Machine learning / data science
# ------------------------------------------------------------------------------
# Model artifacts
*.h5
*.hdf5
*.ckpt
*.pt
*.pth
*.onnx
*.pb
*.joblib
*.pkl
*.pickle
*.npy
*.npz
*.safetensors

# Experiment tracking
mlruns/
wandb/
lightning_logs/
runs/
tensorboard/
.dvc/cache
.dvc/tmp
/outputs/
/checkpoints/

# Data (uncomment to ignore your data directories)
# data/
# datasets/
# *.csv
# *.parquet

# ------------------------------------------------------------------------------
# Secrets / credentials (never commit these)
# ------------------------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
secrets.yaml
secrets.yml
credentials.json
service-account*.json
.secrets/
.aws/
.netrc

# ------------------------------------------------------------------------------
# Logs / temp / local files
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ------------------------------------------------------------------------------
# Databases (local)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# Docker / containers (local overrides)
# ------------------------------------------------------------------------------
docker-compose.override.yml
.docker/

# ------------------------------------------------------------------------------
# Infrastructure (Terraform, etc.)
# ------------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# ------------------------------------------------------------------------------
# IDEs / editors
# ------------------------------------------------------------------------------
# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.iws
out/

# VS Code (keep shared project settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Vim / Emacs
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
.netrwhist
\#*\#
.\#*
.emacs.desktop
.emacs.desktop.lock
auto-save-list
tramp

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse / PyDev
.project
.pydevproject
.settings/

# Cursor / AI tooling local state
.cursor/
.aider*

# ------------------------------------------------------------------------------
# Operating systems
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.fuse_hidden*
.nfs*
.Trash-*